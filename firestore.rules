rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: any authenticated user can read (needed to list the private
    // chat directory); each user can only write their own doc.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Group chat: any authenticated user can read and write messages,
    // but only with their own uid as the sender.
    match /groupMessages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Resource links: any authenticated member can add or edit a link so it
    // becomes visible to everyone (e.g. Zoom link, shared docs, directories).
    match /resourceLinks/{linkId} {
      allow read, write: if request.auth != null;
    }

    // Private chats: only the two participants can read/write.
    match /privateChats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid in chatId.split('_');

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in chatId.split('_');
        allow create: if request.auth != null
          && request.auth.uid in chatId.split('_')
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
